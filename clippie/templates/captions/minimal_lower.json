{
  "id": "minimal_lower",
  "name": "Minimal lower",
  "font": {
    "family": "Inter",
    "file": "Inter-Medium.ttf",
    "size": 46
  },
  "case": "lower",
  "grouping": {
    "max_words": 6,
    "max_chars": 34,
    "max_lines": 2,
    "break_on_pause": 0.5
  },
  "position": {
    "y": 0.85,
    "max_width": 0.84
  },
  "colors": {
    "text": "#FFFFFF",
    "active": "#FFFFFF",
    "emphasis": "#FFD84A",
    "stroke": "#000000",
    "box": null,
    "active_box": null
  },
  "stroke_width": 0,
  "shadow": {
    "dx": 0,
    "dy": 2,
    "blur": 8,
    "color": "#000000CC"
  },
  "active_word": {
    "style": "none",
    "scale": 1.0
  },
  "animation": {
    "in": "fade",
    "duration_ms": 150
  },
  "line_height": 1.3
}
